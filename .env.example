DATABASE_URL=postgresql+psycopg://mapa:mapa@db:5432/mapa_cultural
JWT_SECRET=troque-esta-chave
JWT_EXPIRES_MINUTES=480

# Lidos só por `python -m scripts.seed` (senha com no mínimo 10 caracteres)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=defina-uma-senha-forte
CORS_ORIGINS=http://localhost:3000

# --- Sincronização ---
# Mantenha SYNC_DRY_RUN=true até validar o mapeamento. Em dry-run nada é enviado.
SYNC_DRY_RUN=true
SYNC_INTERVAL_MINUTES=30
SYNC_TIMEOUT_SECONDS=20
SYNC_MAX_RETRIES=3

# Um conjunto por instância. A API de escrita do Mapas Culturais autentica por "App":
# na instância, em Painel > Meus Apps, cria-se um App e copiam-se a chave PÚBLICA e a PRIVADA.
# O App age em nome do usuário que o criou: use uma conta com permissão sobre o que será enviado.
# A chave privada é segredo: nunca versione o .env.
SYNC_AQUIRAZ_BASE_URL=https://mapacultural.aquiraz.ce.gov.br
SYNC_AQUIRAZ_PUBLIC_KEY=
SYNC_AQUIRAZ_PRIVATE_KEY=
SYNC_ESTADO_BASE_URL=https://mapacultural.secult.ce.gov.br
SYNC_ESTADO_PUBLIC_KEY=
SYNC_ESTADO_PRIVATE_KEY=

NEXT_PUBLIC_API_URL=http://localhost:8000
